{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path",
      "sha256",
      "sizeBytes"
    ],
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "sizeBytes": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
