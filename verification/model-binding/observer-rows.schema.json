{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effects",
    "obligations",
    "units"
  ],
  "properties": {
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "classes",
          "operation",
          "organizationRef",
          "installationId",
          "turnId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "organizationRef": {
            "type": "string",
            "minLength": 1
          },
          "installationId": {
            "type": "string",
            "minLength": 1
          },
          "turnId": {
            "type": "string",
            "minLength": 1
          },
          "actorRef": {
            "type": "string",
            "minLength": 1
          },
          "authorizationGrantRef": {
            "type": "string",
            "minLength": 1
          },
          "targetRef": {
            "type": "string",
            "minLength": 1
          },
          "accessContextActorRef": {
            "type": "string",
            "minLength": 1
          },
          "obligationRef": {
            "type": "string",
            "minLength": 1
          },
          "classes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "measurements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value",
                "unit"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "scopeRef",
          "ownerRef",
          "status",
          "nextAction",
          "nextCheckAt",
          "table",
          "rowId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "scopeRef": {
            "type": "string",
            "minLength": 1
          },
          "ownerRef": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "nextAction": {
            "type": "string",
            "minLength": 1
          },
          "nextCheckAt": {
            "type": "string",
            "minLength": 1
          },
          "table": {
            "type": "string",
            "minLength": 1
          },
          "rowId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "units": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
