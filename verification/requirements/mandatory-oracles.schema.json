{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mulino:mandatory-oracles:1.0",
  "title": "Independent normative oracle catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogKind",
    "status",
    "sourceFiles",
    "requiredCaseIds",
    "requirementIds",
    "matchingRules",
    "oracles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "catalogKind": {
      "const": "NORMATIVE_REFERENCE"
    },
    "status": {
      "const": "NOT_RUN"
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1
    },
    "requiredCaseIds": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "uniqueItems": true
    },
    "requirementIds": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "uniqueItems": true
    },
    "matchingRules": {
      "type": "object"
    },
    "oracles": {
      "type": "array",
      "minItems": 41,
      "items": {
        "type": "object",
        "required": [
          "oracleId",
          "caseId",
          "requirementIds",
          "sourceRefs",
          "fixture",
          "requiredLayers",
          "requiredCapabilities",
          "controlPrerequisites",
          "expectedObservations",
          "sharedOracleRefs",
          "status"
        ],
        "properties": {
          "oracleId": {
            "type": "string",
            "pattern": "^(T[0-9]{2}|C[1-5]|V[1-8]|E[12])\\.[a-z0-9][a-z0-9-]*$"
          },
          "caseId": {
            "type": "string"
          },
          "requirementIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^D[0-9]{2}$"
            }
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256",
                "section",
                "clause"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "section": {
                  "type": "string"
                },
                "clause": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "fixture": {
            "type": "object"
          },
          "requiredLayers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "UNIT",
                "API",
                "DB",
                "MCP",
                "SKILLS",
                "MODEL",
                "LOCAL_DEPLOYMENT",
                "BTP_DEPLOYMENT",
                "REGULATORY_REVIEW"
              ]
            }
          },
          "requiredCapabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "controlPrerequisites": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "expectedObservations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "scope",
                "operator",
                "expected",
                "artifactKinds"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "quantity",
                    "status",
                    "effect",
                    "responsibility",
                    "constraint",
                    "equality",
                    "evidence",
                    "version",
                    "authorization",
                    "time",
                    "set"
                  ]
                },
                "scope": {
                  "type": "string"
                },
                "operator": {
                  "enum": [
                    "eq",
                    "lte",
                    "gte",
                    "includes",
                    "excludes",
                    "same",
                    "satisfies"
                  ]
                },
                "expected": {},
                "artifactKinds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "sharedOracleRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "const": "NOT_RUN"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
