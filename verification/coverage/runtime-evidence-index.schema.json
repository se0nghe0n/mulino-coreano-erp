{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulino.test/verification/coverage/runtime-evidence-index.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile",
          "reportRef",
          "evidenceClass"
        ],
        "properties": {
          "profile": {
            "enum": [
              "schema",
              "contracts",
              "scenarios",
              "recovery",
              "mcp",
              "skills",
              "model",
              "local-deployment",
              "btp-deployment",
              "regulatory"
            ]
          },
          "reportRef": {
            "type": "string",
            "minLength": 1
          },
          "receiptRef": {
            "type": "string",
            "minLength": 1
          },
          "evidenceClass": {
            "enum": [
              "ACTUAL",
              "SELFTEST",
              "CONTRACT_RED"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "evidenceClass": {
                  "const": "ACTUAL"
                }
              }
            },
            "then": {
              "required": [
                "receiptRef"
              ]
            }
          }
        ]
      }
    },
    "modelBindingReportRef": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
