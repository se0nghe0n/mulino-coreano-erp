{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulino.test/verification/coverage/execution-receipt.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "evidenceClass",
    "codeCommit",
    "executionIdentity",
    "command",
    "versions",
    "reportArtifact",
    "inputs",
    "artifacts",
    "workingTreeClean",
    "workingTreeObservations",
    "buildIdentity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evidenceClass": {
      "const": "ACTUAL"
    },
    "codeCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "executionIdentity": {
      "type": "object",
      "required": [
        "runId",
        "hostId",
        "workspaceId",
        "actorId"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "hostId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "actorId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "argv",
        "display",
        "exitCode",
        "startedAt",
        "completedAt"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0
        },
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "completedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "required": [
        "schema",
        "definition",
        "evaluator",
        "policy",
        "tool"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "reportArtifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "sizeBytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "sizeBytes",
          "scope",
          "completeness"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "scope": {
            "type": "object",
            "minProperties": 1
          },
          "completeness": {
            "const": "COMPLETE"
          },
          "role": {
            "description": "ENVELOPE (default): a JSON document carrying the receipt's executionIdentity/command/versions, ACTUAL evidenceClass, independent ACTUAL_ provenance and profileResult or observations. RAW_CAPTURE: bytes an adapter captured during the run (an action's artifactRefs). Raw captures are bound by path/hash/bytes/scope only and must be referenced by an envelope observation.",
            "enum": [
              "ENVELOPE",
              "RAW_CAPTURE"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "enum": [
        "LOCAL",
        "BTP",
        "CLIENT",
        "MODEL",
        "REGULATORY"
      ]
    },
    "regulatoryReview": {
      "description": "Required for the regulatory profile: actual official-source review record (plan §13.4, R4). Fictional fixtures never qualify.",
      "type": "object",
      "required": [
        "officialSourceRef",
        "jurisdiction",
        "applicableDate",
        "reviewerId",
        "reviewedAt",
        "fictionalFixture"
      ],
      "properties": {
        "officialSourceRef": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1
        },
        "applicableDate": {
          "type": "string",
          "minLength": 1
        },
        "reviewerId": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1
        },
        "fictionalFixture": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "workingTreeClean": {
      "description": "git status --porcelain was empty for the executed checkout; a dirty run cannot identify codeCommit (plan §13.4).",
      "const": true
    },
    "caseVersions": {
      "description": "Per executed case/subcase fixture versions when one run installs fixtures with different definition/evaluator/policy versions. A top-level versions value of PER_CASE requires an exact entry here.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "caseId",
          "subcaseId",
          "versions"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "subcaseId": {
            "type": "string",
            "minLength": 1
          },
          "versions": {
            "type": "object",
            "required": [
              "definition",
              "evaluator",
              "policy"
            ],
            "properties": {
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "evaluator": {
                "type": "string",
                "minLength": 1
              },
              "policy": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "workingTreeObservations": {
      "description": "git HEAD and status observed by the harness before the first case ran (before) and after the run (after). Both clean at codeCommit; the assembler also compares before with the report's preRun.",
      "type": "object",
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "type": "object",
          "required": [
            "codeCommit",
            "clean",
            "observedAt"
          ],
          "properties": {
            "codeCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "clean": {
              "const": true
            },
            "observedAt": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "after": {
          "type": "object",
          "required": [
            "codeCommit",
            "clean",
            "observedAt"
          ],
          "properties": {
            "codeCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "clean": {
              "const": true
            },
            "observedAt": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "buildIdentity": {
      "description": "Backend build identity. DECLARED_ACTUAL_BUILD_COMMIT: the ACTUAL_BUILD_COMMIT declaration; the harness cannot observe the running backend's build (no build-info endpoint).",
      "type": "object",
      "required": [
        "commit",
        "source"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "DECLARED_ACTUAL_BUILD_COMMIT"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
