{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulino.test/verification/coverage/execution-receipt.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "evidenceClass",
    "codeCommit",
    "executionIdentity",
    "command",
    "versions",
    "reportArtifact",
    "inputs",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "evidenceClass": {
      "const": "ACTUAL"
    },
    "codeCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "executionIdentity": {
      "type": "object",
      "required": [
        "runId",
        "hostId",
        "workspaceId",
        "actorId"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "hostId": {
          "type": "string",
          "minLength": 1
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1
        },
        "actorId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": [
        "argv",
        "display",
        "exitCode",
        "startedAt",
        "completedAt"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "display": {
          "type": "string",
          "minLength": 1
        },
        "exitCode": {
          "type": "integer",
          "minimum": 0
        },
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "completedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "required": [
        "schema",
        "definition",
        "evaluator",
        "policy",
        "tool"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "reportArtifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "sizeBytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "sizeBytes",
          "scope",
          "completeness"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "scope": {
            "type": "object",
            "minProperties": 1
          },
          "completeness": {
            "const": "COMPLETE"
          }
        },
        "additionalProperties": false
      }
    },
    "environment": {
      "enum": [
        "LOCAL",
        "BTP",
        "CLIENT",
        "MODEL",
        "REGULATORY"
      ]
    }
  },
  "additionalProperties": false
}
