{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "fixtureId": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "const": true
    },
    "baseRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "clock": {
      "type": "object",
      "properties": {
        "asOf": {
          "type": "string",
          "minLength": 1
        },
        "knownAt": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "type": "string",
          "minLength": 1
        },
        "deadlineInclusive": {
          "type": "boolean"
        }
      },
      "required": [
        "asOf",
        "knownAt",
        "timezone",
        "precision",
        "deadlineInclusive"
      ],
      "additionalProperties": false
    },
    "versions": {
      "type": "object",
      "properties": {
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "definition",
        "evaluator",
        "policy"
      ],
      "additionalProperties": true
    },
    "actors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "audience": {
            "type": "string",
            "minLength": 1
          },
          "organizationAlias": {
            "type": "string",
            "minLength": 1
          },
          "roleCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "grant": {
            "type": "object",
            "properties": {
              "delegatorAlias": {
                "type": "string",
                "minLength": 1
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "scope": {
                "type": "object"
              },
              "validFrom": {
                "type": "string",
                "minLength": 1
              },
              "validUntil": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "scopeComposition": {
                "enum": [
                  "PER_DIMENSION",
                  "ALL_DIMENSIONS"
                ],
                "description": "How the dimension kinds of scope combine (contracts/request-contracts.json grantComposition). PER_DIMENSION: one installed grant per kind, the lists act as alternatives. ALL_DIMENSIONS: one grant whose kinds intersect (the product's all-of match). Required when scope names two or more kinds (./verify prepare, check_request_contracts.py)."
              }
            },
            "required": [
              "delegatorAlias",
              "actions",
              "scope",
              "validFrom",
              "validUntil",
              "revision"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "issuer",
          "subject",
          "audience",
          "organizationAlias",
          "roleCapabilities",
          "grant"
        ],
        "additionalProperties": false
      }
    },
    "aliases": {
      "description": "Fixture aliases. A Place alias has a kind from contracts/fixture-place-kinds.json (INTERNAL_STORAGE, TRANSIT, CUSTOMER, SUPPLIER, EXTERNAL_PORT) or the declared negative control kindControl=UNRECOGNIZED_PLACE_KIND; a QuantitySegment at INTERNAL_STORAGE names an internal custodian (Human/Agent alias) in custodianAlias. ./verify prepare enforces both (ContractValidator.placeKindProblems). An Allocation that a case dispatches is installed already picked: pickedAt (an ISO-8601 instant not after the clock knownAt) and pickedByAlias (a fixture actor) beside its state (alias, baseline.priorEntities entry or baseline.allocations/allocation row), unless an earlier pickQuantity of the subcase picks it (ContractValidator.pickBeforeDispatchProblems, step2r round 9).",
      "type": "object",
      "minProperties": 1
    },
    "baseline": {
      "type": "object",
      "properties": {
        "runtimeProfile": {
          "description": "Scheduler/sweeper tick semantics of the fixture (verification/host-observation-guide.md, runtimeProfile). controlledTicks=true and pausedUntilTickControl=true: the loops submit nothing by themselves and each harness tickScheduler/sweepDue request causes exactly that tick. controlledTicks=false and pausedUntilTickControl=false: the loops run on their own tickSeconds and only a passive OBSERVE_NEXT_NATURAL_TICK watcher observes them. A fixture without runtimeProfile is a harness-tick fixture.",
          "type": "object",
          "properties": {
            "controlledTicks": {"type": "boolean"},
            "pausedUntilTickControl": {"type": "boolean"},
            "tickSeconds": {"type": "integer", "minimum": 1},
            "claimTTLSeconds": {"type": "integer", "minimum": 1},
            "heartbeatSeconds": {"type": "integer", "minimum": 1},
            "observationLimitSeconds": {"type": "integer", "minimum": 1, "maximum": 30}
          },
          "required": ["controlledTicks", "pausedUntilTickControl"],
          "allOf": [
            {
              "if": {"properties": {"controlledTicks": {"const": false}}},
              "then": {"properties": {"pausedUntilTickControl": {"const": false}}}
            },
            {
              "if": {"properties": {"pausedUntilTickControl": {"const": false}}},
              "then": {"properties": {"controlledTicks": {"const": false}}}
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceNamespace": {
            "type": "string",
            "minLength": 1
          },
          "externalEventId": {
            "type": "string",
            "minLength": 1
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "occurredAt": {
            "type": "string",
            "minLength": 1
          },
          "recordedAt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "alias",
          "sha256",
          "sourceNamespace",
          "externalEventId",
          "sourceVersion",
          "occurredAt",
          "recordedAt"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "object"
          },
          "ownerAlias": {
            "type": "string",
            "minLength": 1
          },
          "supervisorAlias": {
            "type": "string",
            "minLength": 1
          },
          "nextAction": {
            "type": "string",
            "minLength": 1
          },
          "nextCheckAt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scope",
          "ownerAlias",
          "supervisorAlias",
          "nextAction",
          "nextCheckAt"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "fixtureId",
    "synthetic",
    "baseRefs",
    "clock",
    "versions",
    "actors",
    "aliases",
    "baseline",
    "evidence",
    "responsibilities"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulino.test/contracts/acceptance-fixture.schema.json"
}
