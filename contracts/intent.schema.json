{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mulino:intent:1",
  "title": "Mulino typed intent",
  "type": "object",
  "required": [
    "intentKind",
    "definitionVersion",
    "capabilityId",
    "subjectRefs",
    "slots",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "intentKind": {
      "enum": [
        "QUERY",
        "RECORD",
        "COMMAND"
      ]
    },
    "definitionVersion": {
      "type": "string",
      "minLength": 1
    },
    "capabilityId": {
      "type": "string",
      "minLength": 1
    },
    "subjectRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "USER",
          "CONTEXT",
          "APPROVED_DEFAULT"
        ]
      }
    },
    "conversationRequestId": {
      "type": "string",
      "minLength": 1
    },
    "proposalRevision": {
      "type": "integer",
      "minimum": 0
    },
    "canonicalIntentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commandIdempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    },
    "capabilityVersion": {
      "type": "string",
      "minLength": 1
    },
    "approvalId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "type": "object",
          "description": "Handler-specific bounded typed aggregate value; validated by the registered capability schema.",
          "not": {
            "anyOf": [
              {
                "required": [
                  "value",
                  "unit"
                ]
              },
              {
                "required": [
                  "type",
                  "id"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
