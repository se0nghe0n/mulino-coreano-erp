{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "caseId": {
      "type": "string",
      "pattern": "^(T[0-9]{2}|C[1-5]|V[1-8]|E[12]|HARNESS-[A-Z0-9-]+)$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "requirementRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "profiles": {
      "type": "array",
      "items": {
        "enum": [
          "schema",
          "contracts",
          "scenarios",
          "recovery",
          "mcp",
          "skills",
          "model",
          "deployment"
        ]
      },
      "minItems": 1
    },
    "subcases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "fixtureRef": {
            "type": "string",
            "minLength": 1
          },
          "requiredAdapters": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/action"
            },
            "minItems": 1
          },
          "assertions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/assertion"
            },
            "minItems": 1
          },
          "oracleExplanation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "fixtureRef",
          "requiredAdapters",
          "actions",
          "assertions",
          "oracleExplanation"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "caseId",
    "title",
    "requirementRefs",
    "profiles",
    "subcases"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulino.test/contracts/acceptance-case.schema.json",
  "$defs": {
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "installFixture",
            "invoke",
            "query",
            "observe",
            "control",
            "agent",
            "parallel",
            "await",
            "start"
          ]
        },
        "actorRef": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "enum": [
            "api",
            "odata",
            "mcp",
            "worker",
            "direct",
            "nested",
            "batch",
            "projection",
            "blob",
            "management",
            "client",
            "db",
            "platform",
            "wire"
          ]
        },
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "type": "object",
          "$ref": "#/$defs/inputEncodingValue"
        },
        "observation": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "object",
              "minProperties": 1
            },
            "snapshotRef": {
              "oneOf": [
                {
                  "enum": [
                    "CURRENT_COMMITTED",
                    "CURRENT_LOCK_WAIT"
                  ],
                  "description": "Read-mode directive: the observer takes a fresh read; never echoed as snapshot.id or snapshotRevision."
                },
                {
                  "$ref": "#/$defs/resultReference",
                  "description": "Either an API-issued projection revision (/response/snapshotRevision of an invoke/query/start; observer request RESULT_REVISION, recomputed independently) or the host terminal snapshot id of an awaitRuntimeTask control (/data/hostObservation/runtimeTask/snapshot/id; observer request RUNTIME_TASK_SNAPSHOT, bound to the host snapshot artifact). ./verify prepare rejects any other pointer."
                }
              ]
            },
            "asOf": {
              "type": "string",
              "minLength": 1
            },
            "knownAt": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "scope",
            "snapshotRef",
            "asOf",
            "knownAt",
            "sources"
          ],
          "additionalProperties": false
        },
        "control": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "clock",
                "barrier",
                "fault",
                "process",
                "externalResponder",
                "workerClaim"
              ]
            },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object"
            }
          },
          "required": [
            "type",
            "operation",
            "parameters"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "workerClaim"
                  }
                }
              },
              "then": {
                "properties": {
                  "operation": {
                    "const": "issue"
                  },
                  "parameters": {
                    "type": "object",
                    "required": [
                      "actorRef",
                      "workId",
                      "capabilityId",
                      "commandId",
                      "workerId",
                      "ttlSeconds"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "actorRef": {
                        "type": "string",
                        "minLength": 1
                      },
                      "workId": {
                        "oneOf": [
                          {
                            "type": "string",
                            "format": "uuid"
                          },
                          {
                            "type": "object",
                            "required": [
                              "$alias"
                            ],
                            "properties": {
                              "$alias": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "additionalProperties": false
                          }
                        ]
                      },
                      "capabilityId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "commandId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "workerId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "ttlSeconds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 300
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "intent": {
          "type": "object"
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "actions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/action"
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "actions"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "awaitActionId": {
          "type": "string",
          "minLength": 1
        },
        "fixtureRef": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "call": {
          "$ref": "#/$defs/action"
        },
        "userUtterance": {
          "type": "string",
          "minLength": 1
        },
        "permittedContext": {
          "type": "object"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "protocolOperation": {
          "type": "string",
          "minLength": 1
        },
        "custodyControl": {
          "enum": [
            "FORBIDDEN",
            "SCOPE_INELIGIBLE",
            "EVIDENCE_CONFLICT",
            "EVIDENCE_UNVERIFIED"
          ],
          "description": "Declared receiving-custody negative on a confirmReceipt that carries receivingCustodianId (contracts/fixture-place-kinds.json directReceiptCustody.custodyControl). Harness-side declaration; never sent to the product."
        },
        "harness": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "description": "Harness-side declarations of an invoke/query action (contracts/request-contracts.json harnessDeclarations). Adapters read them to drive the call; none is sent as a request field. ./verify prepare (check_request_contracts.py) enforces the request contracts and the intentionalViolation declaration.",
          "properties": {
            "testBarrier": {
              "type": "object",
              "required": [
                "transactionId",
                "participantId",
                "barrierId",
                "point"
              ],
              "additionalProperties": false,
              "properties": {
                "transactionId": {
                  "type": "string",
                  "minLength": 1
                },
                "participantId": {
                  "type": "string",
                  "minLength": 1
                },
                "barrierId": {
                  "type": "string",
                  "minLength": 1
                },
                "point": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "environmentId": {
              "type": "string",
              "minLength": 1
            },
            "authenticationTest": {
              "type": "object"
            },
            "executionContext": {
              "type": "object"
            },
            "mcp": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "transport": {
                  "type": "object"
                },
                "requestState": {},
                "inputResponses": {
                  "type": "object"
                }
              }
            },
            "intentionalViolation": {
              "type": "object",
              "required": [
                "fields",
                "reason"
              ],
              "additionalProperties": false,
              "properties": {
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "unpinnedBecause": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "workerClaim": {
              "description": "Explicit server-issued claim reference, resolved from a workerClaim issue control. Never implicitly issued by the adapter.",
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "$result"
                  ],
                  "properties": {
                    "$result": {
                      "type": "object",
                      "required": [
                        "actionId",
                        "pointer"
                      ],
                      "properties": {
                        "actionId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pointer": {
                          "const": "/response/claim"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "claimId": {
                      "type": "string"
                    },
                    "fencingToken": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "claimId",
                    "fencingToken"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      },
      "required": [
        "id",
        "kind",
        "evidenceRefs"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "invoke",
                  "query"
                ]
              }
            }
          },
          "then": {
            "required": [
              "actorRef",
              "route",
              "request"
            ],
            "oneOf": [
              {
                "required": [
                  "capabilityId"
                ],
                "not": {
                  "required": [
                    "protocolOperation"
                  ]
                }
              },
              {
                "required": [
                  "protocolOperation"
                ],
                "properties": {
                  "route": {
                    "const": "wire"
                  }
                },
                "not": {
                  "required": [
                    "capabilityId"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "observe"
                ]
              }
            }
          },
          "then": {
            "required": [
              "observation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "control"
                ]
              }
            }
          },
          "then": {
            "required": [
              "control"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "agent"
                ]
              }
            }
          },
          "then": {
            "required": [
              "actorRef",
              "route",
              "intent"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "parallel"
                ]
              }
            }
          },
          "then": {
            "required": [
              "branches"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "await"
                ]
              }
            }
          },
          "then": {
            "required": [
              "awaitActionId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "start"
              }
            }
          },
          "then": {
            "required": [
              "call"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            }
          },
          "then": {
            "required": [
              "userUtterance",
              "permittedContext"
            ]
          }
        },
        {
          "if": {
            "required": [
              "protocolOperation"
            ]
          },
          "then": {
            "properties": {
              "route": {
                "const": "wire"
              },
              "kind": {
                "enum": [
                  "invoke",
                  "query"
                ]
              }
            },
            "required": [
              "route"
            ]
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "equals",
            "notEquals",
            "present",
            "absent",
            "decimalEquals",
            "decimalAtMost",
            "decimalAtLeast",
            "sumEquals",
            "decimalDelta",
            "count",
            "exactSet",
            "relationSet",
            "unique",
            "sameAs",
            "fieldsPresent",
            "timeEquals",
            "timeBefore",
            "timeAtMostSeconds"
          ]
        },
        "source": {
          "type": "object",
          "properties": {
            "actionId": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^(/.*)?$"
            },
            "where": {
              "type": "object",
              "minProperties": 1
            },
            "field": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              ]
            }
          },
          "required": [
            "actionId",
            "pointer"
          ],
          "additionalProperties": false
        },
        "baseline": {
          "type": "object",
          "properties": {
            "actionId": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^(/.*)?$"
            },
            "where": {
              "type": "object",
              "minProperties": 1
            },
            "field": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              ]
            }
          },
          "required": [
            "actionId",
            "pointer"
          ],
          "additionalProperties": false
        },
        "expected": {},
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "requirementRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "scope": {
          "type": "object",
          "minProperties": 1
        },
        "oracleExplanation": {
          "type": "string",
          "minLength": 1
        },
        "oracleRef": {
          "type": "object",
          "required": [
            "oracleId",
            "observationNames"
          ],
          "properties": {
            "oracleId": {
              "type": "string",
              "minLength": 1
            },
            "observationNames": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "unitSource": {
          "type": "object",
          "properties": {
            "actionId": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^(/.*)?$"
            },
            "where": {
              "type": "object",
              "minProperties": 1
            },
            "field": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              ]
            }
          },
          "required": [
            "actionId",
            "pointer"
          ],
          "additionalProperties": false
        },
        "baselineUnitSource": {
          "type": "object",
          "properties": {
            "actionId": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^(/.*)?$"
            },
            "where": {
              "type": "object",
              "minProperties": 1
            },
            "field": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              ]
            }
          },
          "required": [
            "actionId",
            "pointer"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "op",
        "source",
        "expected",
        "requirementRefs",
        "evidenceRefs",
        "scope",
        "oracleExplanation"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "decimalDelta"
              }
            }
          },
          "then": {
            "required": [
              "baseline"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "sameAs"
              }
            }
          },
          "then": {
            "required": [
              "baseline"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "decimalEquals",
                  "decimalAtMost",
                  "decimalAtLeast",
                  "sumEquals",
                  "decimalDelta"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "unit"
            ]
          },
          "then": {
            "required": [
              "unitSource"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "decimalDelta"
              }
            },
            "required": [
              "unit"
            ]
          },
          "then": {
            "required": [
              "baselineUnitSource"
            ]
          }
        },
        {
          "$ref": "#/$defs/noInputEncoding"
        }
      ]
    },
    "resultReference": {
      "type": "object",
      "required": [
        "$result"
      ],
      "additionalProperties": false,
      "properties": {
        "$result": {
          "type": "object",
          "required": [
            "actionId",
            "pointer"
          ],
          "additionalProperties": false,
          "properties": {
            "actionId": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^/.*"
            }
          }
        }
      }
    },
    "aliasReference": {
      "type": "object",
      "required": [
        "$alias"
      ],
      "additionalProperties": false,
      "properties": {
        "$alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transformReference": {
      "type": "object",
      "required": [
        "$transform"
      ],
      "additionalProperties": false,
      "properties": {
        "$transform": {
          "type": "object",
          "properties": {
            "source": {
              "$ref": "#/$defs/resultReference"
            },
            "operation": {
              "enum": [
                "opaqueByteXor",
                "jsonPointerReplace",
                "jsonPointerRemove"
              ]
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "xor": {
              "type": "integer",
              "minimum": 1,
              "maximum": 127
            },
            "pointer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^/"
            },
            "value": {}
          },
          "required": [
            "source",
            "operation"
          ],
          "additionalProperties": false,
          "oneOf": [
            {
              "properties": {
                "operation": {
                  "const": "opaqueByteXor"
                }
              },
              "required": [
                "index",
                "xor"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "pointer"
                    ]
                  },
                  {
                    "required": [
                      "value"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "operation": {
                  "const": "jsonPointerReplace"
                }
              },
              "required": [
                "pointer",
                "value"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "index"
                    ]
                  },
                  {
                    "required": [
                      "xor"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "operation": {
                  "const": "jsonPointerRemove"
                }
              },
              "required": [
                "pointer"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "index"
                    ]
                  },
                  {
                    "required": [
                      "xor"
                    ]
                  },
                  {
                    "required": [
                      "value"
                    ]
