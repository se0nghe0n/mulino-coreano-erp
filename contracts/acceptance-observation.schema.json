{
  "type": "object",
  "properties": {
    "snapshotRevision": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "minLength": 1
    },
    "knownAt": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "minProperties": 1
    },
    "scopeComplete": {
      "const": true
    },
    "sourceQuery": {
      "type": "object",
      "properties": {
        "statementId": {
          "type": "string",
          "minLength": 1
        },
        "sql": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "mappingVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "statementId",
        "sql",
        "parameters",
        "mappingVersion"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The observer's own DB snapshot token (for example pg_current_snapshot()). Never the requested snapshotRef or a read-mode directive."
        },
        "isolation": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "minLength": 1
        },
        "artifactRef": {
          "type": "string",
          "minLength": 1
        },
        "readMode": {
          "enum": [
            "RESULT_REVISION",
            "RUNTIME_TASK_SNAPSHOT",
            "CURRENT_COMMITTED",
            "CURRENT_LOCK_WAIT"
          ],
          "description": "RESULT_REVISION: snapshotRef is an API-issued projection revision that the observer recomputed from rows. RUNTIME_TASK_SNAPSHOT: snapshotRef is the host terminal snapshot of an awaitRuntimeTask; the observer bound its read to that task's host snapshot artifact (runtimeTaskSnapshot) and no revision equality applies. CURRENT_*: the case asked for a fresh read; no revision equality applies."
        },
        "revisionQuery": {
          "type": "object",
          "properties": {
            "statementId": {
              "type": "string",
              "minLength": 1
            },
            "sql": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "object"
            },
            "mappingVersion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "statementId",
            "sql",
            "parameters",
            "mappingVersion"
          ],
          "additionalProperties": false,
          "description": "Read-only query the observer used to recompute snapshotRevision independently from authoritative rows."
        },
        "runtimeTaskSnapshot": {
          "type": "object",
          "properties": {
            "schedulerId": {
              "type": "string",
              "minLength": 1
            },
            "taskId": {
              "type": "string",
              "minLength": 1
            },
            "invocationHandle": {
              "type": "string",
              "minLength": 1
            },
            "snapshotId": {
              "type": "string",
              "minLength": 1
            },
            "artifactRef": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "schedulerId",
            "taskId",
            "invocationHandle",
            "snapshotId",
            "artifactRef",
            "sha256"
          ],
          "additionalProperties": false,
          "description": "The host runtime snapshot the observer located from snapshotSource (schedulerId/taskId/invocationHandle) and read: its snapshotId, repository artifactRef and SHA-256 of the artifact bytes. The harness compares them with the awaitRuntimeTask result and the file."
        }
      },
      "required": [
        "id",
        "isolation",
        "capturedAt",
        "artifactRef"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "readMode": {
                "const": "RESULT_REVISION"
              }
            },
            "required": [
              "readMode"
            ]
          },
          "then": {
            "required": [
              "revisionQuery"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "readMode": {
                "const": "RUNTIME_TASK_SNAPSHOT"
              }
            },
            "required": [
              "readMode"
            ]
          },
          "then": {
            "required": [
              "runtimeTaskSnapshot"
            ]
          },
          "else": {
            "not": {
              "required": [
                "runtimeTaskSnapshot"
              ]
            }
          }
        }
      ]
    },
    "rawRows": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "data": {
      "type": "object",
      "description": "Observer-derived values only. Every field must have a matching derivations entry that the harness recomputes from rawRows; free-form values are rejected."
    },
    "derivations": {
      "type": "object",
      "description": "Fixed-grammar derivation of each data field from requested rawRows; recomputed by the harness.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rowPointer": {
            "type": "string",
            "pattern": "^/rawRows/.+"
          },
          "where": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "aggregate": {
            "enum": [
              "sum",
              "count",
              "single",
              "distinct"
            ]
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "unitField": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "rowPointer",
          "aggregate"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "aggregate": {
                  "enum": [
                    "sum",
                    "single",
                    "distinct"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "field"
              ]
            }
          }
        ]
      }
    },
    "sourceEvidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "complete",
          "rowPointer",
          "sourceQuery",
          "artifactRef"
        ],
        "properties": {
          "complete": {
            "const": true
          },
          "rowPointer": {
            "type": "string",
            "pattern": "^/rawRows/.+"
          },
          "sourceQuery": {
            "type": "object",
            "properties": {
              "statementId": {
                "type": "string",
                "minLength": 1
              },
              "sql": {
                "type": "string",
                "minLength": 1
              },
              "parameters": {
                "type": "object"
              },
              "mappingVersion": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "statementId",
              "sql",
              "parameters",
              "mappingVersion"
            ],
            "additionalProperties": false
          },
          "artifactRef": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "snapshotRevision",
    "asOf",
    "knownAt",
    "scope",
    "scopeComplete",
    "sourceQuery",
    "snapshot",
    "rawRows",
    "data",
    "sourceEvidence"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mulino.test/contracts/acceptance-observation.schema.json"
}
