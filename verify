#!/usr/bin/env python3
"""Thin argument-safe launcher; harness/preparation and actual product gates remain distinct."""
import json, os, pathlib, shlex, subprocess, sys, time
ROOT=pathlib.Path(__file__).resolve().parent
POM=ROOT/'verification/harness/pom.xml'
OUT=ROOT/'verification/harness/target'
OUT.mkdir(parents=True,exist_ok=True)
records=[]
def command(argv):
    print('+ '+shlex.join(str(x) for x in argv),flush=True)
    started=time.time()
    p=subprocess.run([str(x) for x in argv],cwd=ROOT)
    records.append({'command':[str(x) for x in argv],'exitCode':p.returncode,'elapsedSeconds':round(time.time()-started,3)})
    print('exitCode='+str(p.returncode),flush=True)
    return p.returncode
def finish(code):
    (OUT/'wrapper-commands.json').write_text(json.dumps({'entrypoint':['./verify']+sys.argv[1:],'timestamp':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),'commands':records,'exitCode':code},indent=2)+'\n')
    sys.exit(code)
if len(sys.argv)<2:
    print('Usage: ./verify harness|contract-red|validate <case.json...>|prepare|coverage|schema|contracts|scenarios|recovery|mcp|skills | model --manifest <path> | deployment --manifest <path> | regulatory (NOT_RUN gate)',file=sys.stderr)
    finish(3)
mode=sys.argv[1]; extras=sys.argv[2:]
actual='--actual' in extras
extras=[x for x in extras if x!='--actual']
runner=[x.split('=',1)[1] for x in extras if x.startswith('--agent-runner=')]
extras=[x for x in extras if not x.startswith('--agent-runner=')]
if len(runner)>1 or (runner and runner[0] not in {'scripted','actual'}):
    print('--agent-runner=scripted|actual may appear once',file=sys.stderr);finish(3)
if actual and mode in {'contract-red','harness','prepare','coverage','validate','model','deployment','regulatory'}:
    print('--actual requires a deterministic product profile',file=sys.stderr);finish(3)
if any(x=='--manifest' or x.startswith('--manifest=') for x in extras) and mode not in {'model','deployment'}:
    print('--manifest applies only to model/deployment',file=sys.stderr);finish(3)
if mode=='regulatory':
    # Plan §13.4 regulatory evidence (T15 REGULATORY_REVIEW observations) needs a reviewed record and an approved runner;
    # neither exists here, so this named entrypoint only reports the gate. No receipt or index entry is written.
    print('NOT_RUN_GATED regulatory: no regulatory runner. A reviewed regulatory record (official source, jurisdiction, '
          'applicable date, reviewer) and an approved runner that reruns the T15 regulatory subcases are required; '
          'verify prepare lists them under runtimeGates and the coverage assembler keeps the regulatory profile NOT_RUN.',file=sys.stderr)
    finish(2)
if mode not in {'harness','contract-red','validate','prepare','coverage','schema','contracts','scenarios','recovery','mcp','skills','model','deployment','actual-s1','actual-s2','actual-s3','actual-s4'}:
    print('Unknown verification profile: '+mode,file=sys.stderr);finish(3)
if mode=='coverage':
    # Plan §13.4 coverage verifier: the assembler re-reads every case/catalog/receipt byte and runs a fresh ./verify prepare
    # itself (--check-preparation). Model-binding preparation is its separate prepared input. Exit code is the assembler's.
    index=[]
    rest=list(extras)
    while rest:
        item=rest.pop(0)
        if item=='--index' and rest: index=['--index',rest.pop(0)]
        elif item.startswith('--index='): index=['--index',item.split('=',1)[1]]
        else:
            print('coverage accepts only --index <runtime-evidence-index.json>',file=sys.stderr);finish(3)
    if command([ROOT/'verification/model-binding/run','prepare']): print('model-binding preparation did not complete; the assembler reports model preparation as missing',file=sys.stderr)
    finish(command([sys.executable,ROOT/'verification/coverage/assemble.py','--check-preparation']+index))
if command(['java','-version']) or command([ROOT/'mvnw','-version']): finish(3)
maven=[ROOT/'mvnw','-B','-ntp','-f',POM]
if mode=='harness':
    code=command(maven+['test'])
    if code: finish(code)
    smoke=OUT/'cucumber.json'
    if not smoke.exists() or sum(len(f.get('elements',[])) for f in json.loads(smoke.read_text()))!=1:
        print('FAIL: expected one Korean harness smoke scenario; empty suite is invalid',file=sys.stderr);finish(1)
    finish(0)
if mode=='contract-red' and not extras:
    report=OUT/'evidence/contract-red-example.json'
    if report.exists(): report.unlink()
    feature=ROOT/'verification/harness/src/test/resources/examples/HARNESS-EXAMPLE/scenario.feature'
    code=command(maven+['-Dtest=ContractRedTest','-Dverification.mode=contract-red','-Dverification.command=./verify contract-red','test'])
    if not report.exists():
        print('ENVIRONMENT_OR_DISCOVERY_FAILURE: no contract evidence emitted',file=sys.stderr);finish(3)
    evidence=json.loads(report.read_text())
    fail=evidence.get('status')=='FAIL' and any(a.get('status')=='FAIL' and 'NOT_IMPLEMENTED' in a.get('reason','') for a in evidence.get('assertions',[]))
    discovery=OUT/'contract-red-cucumber.json'
    scenarios=[e for f in json.loads(discovery.read_text()) for e in f.get('elements',[]) if e.get('type')=='scenario'] if discovery.exists() else []
    actual_failed=sum(any(st.get('result',{}).get('status')=='failed' and 'NOT_IMPLEMENTED' in st.get('result',{}).get('error_message','') for st in e.get('steps',[])) for e in scenarios)
    if code!=1 or not fail or len(scenarios)!=1 or actual_failed!=1:
        print('FAIL: RED must be business availability assertion NOT_IMPLEMENTED, not syntax/environment error',file=sys.stderr);finish(3)
    finish(1)
if mode=='contract-red' and extras and '--all' not in extras:
    summary=OUT/'evidence/feature-red-summary.json'
    if summary.exists(): summary.unlink()
    code=command(maven+['-Dtest=CaseFeatureTest','-Dverification.mode=contract-red','-Dverification.command='+shlex.join(['./verify',mode]+extras),'-Dverification.caseFiles='+'|'.join(extras),'test'])
    if not summary.exists(): finish(3)
    result=json.loads(summary.read_text())
    if code!=1 or result['expectedScenarios']!=result['discoveredScenarios'] or result['expectedScenarios']!=result['notImplementedAssertionFailures'] or result['skippedScenarios']!=0: finish(3)
    finish(1)
if command(maven+['-Dmaven.test.skip=true','package','dependency:build-classpath','-Dmdep.outputFile=target/classpath.txt']): finish(3)
classpath=str(OUT/'classes')+os.pathsep+(OUT/'classpath.txt').read_text().strip()
if mode in {'actual-s1','actual-s2','actual-s3','actual-s4'}:
    if len(extras)>1:
        print(mode+' accepts at most one fresh evidence directory',file=sys.stderr);finish(3)
    finish(command(['sh',ROOT/('verification/actual/'+mode.removeprefix('actual-')+'/run.sh')]+extras))
args=['red']+extras if mode=='contract-red' else [mode]+extras if mode in {'validate','prepare'} else ['profile',mode]+extras
argv=['./verify']+sys.argv[1:]
finish(command(['java',f'-Dverification.driver={"actual" if actual else "unimplemented"}',f'-Dverification.agentRunner={runner[0] if runner else "scripted"}',f'-Drepo.root={ROOT}',f'-Dverification.command={shlex.join(["./verify",mode]+extras)}',f'-Dverification.argv={json.dumps(argv)}','-cp',classpath,'org.mulino.verification.Main']+args))
