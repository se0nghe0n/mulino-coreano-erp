namespace mulino.definitions;
entity DefinitionVersions { key organizationId : UUID; key ID : UUID; revision : Integer; createdAt : Timestamp; version : String(80); parentVersionId : UUID; state : String(24); contentHash : String(64); content : LargeString; evaluatorVersion : String(80); schemaVersion : String(40); }
entity NounTypes { key organizationId : UUID; key ID : UUID; revision : Integer; createdAt : Timestamp; definitionVersionId : UUID; name : String(80); core : Boolean; }
entity AttributeDefinitions { key organizationId : UUID; key ID : UUID; revision : Integer; createdAt : Timestamp; definitionVersionId : UUID; nounType : String(80); name : String(80); valueType : String(24); referenceType : String(80); unit : String(24); decimalPlaces : Integer; minimumCount : Integer; maximumCount : Integer; requiredStage : String(40); core : Boolean; }
entity VerbDefinitions { key organizationId : UUID; key ID : UUID; revision : Integer; createdAt : Timestamp; definitionVersionId : UUID; name : String(80); intentKind : String(16); capabilityId : String(80); stage : String(40); slots : LargeString; }
entity RelationDefinitions { key organizationId : UUID; key ID : UUID; revision : Integer; createdAt : Timestamp; definitionVersionId : UUID; name : String(80); sourceType : String(80); targetType : String(80); minimumCount : Integer; maximumCount : Integer; cycleAllowed : Boolean; }
entity GoalTemplates { key organizationId : UUID; key ID : UUID; revision : Integer; createdAt : Timestamp; definitionVersionId : UUID; name : String(80); quantityMode : String(32); endpoint : String(80); evaluatorVersion : String(80); predicate : LargeString; }
entity CapabilityContracts { key organizationId : UUID; key ID : UUID; revision : Integer; createdAt : Timestamp; definitionVersionId : UUID; capabilityId : String(80); semanticVersion : String(80); evaluatorVersion : String(80); inputSchemaVersion : String(40); outputSchemaVersion : String(40); supportedWorkMigration : LargeString; }
// V35 plan §8 package lifecycle rows (DefinitionLifecycleRepository).
entity DefinitionLifecycles { key organizationId : UUID; key definitionId : UUID; revision : Integer not null; createdBy : UUID not null; regressionFixtureRefs : LargeString not null default '[]'; createdAt : Timestamp not null; recordedAt : Timestamp not null; }
entity DefinitionValidations { key organizationId : UUID; key ID : UUID; definitionId : UUID not null; hash : String(64) not null; outcome : String(24) not null; publishable : Boolean not null; problemsJson : LargeString not null; diffClassesJson : LargeString not null; regressionJson : LargeString not null; actorId : UUID not null; recordedAt : Timestamp not null; }
entity DefinitionReviews { key organizationId : UUID; key ID : UUID; definitionId : UUID not null; hash : String(64) not null; reviewKind : String(24) not null; validationId : UUID; migrationId : String(80); payloadJson : LargeString not null; actorId : UUID not null; recordedAt : Timestamp not null; }
entity DefinitionApprovals { key organizationId : UUID; key ID : UUID; definitionId : UUID not null; hash : String(64) not null; reviewId : UUID not null; reviewKind : String(24) not null; approverId : UUID not null; decision : String(16) not null; reason : String(500); validFrom : Timestamp not null; validUntil : Timestamp not null; consumptionPolicy : String(40) not null; goalChangesJson : LargeString; consumedAt : Timestamp; consumedBy : UUID; recordedAt : Timestamp not null; }
entity ActiveDefinitionPointers { key organizationId : UUID; definitionId : UUID not null; version : String(80) not null; hash : String(64) not null; effectiveAt : Timestamp not null; actorId : UUID not null; revision : Integer not null; recordedAt : Timestamp not null; }
entity DefinitionRetirements { key organizationId : UUID; key definitionId : UUID; reason : String(500) not null; actorId : UUID not null; retiredAt : Timestamp not null; }
entity WorkDefinitionMigrations { key organizationId : UUID; key ID : UUID; workId : UUID not null; approvalId : UUID not null; migrationId : String(80) not null; previousDefinitionId : UUID not null; definitionId : UUID not null; previousGoalVersionId : UUID not null; goalVersionId : UUID not null; actorId : UUID not null; reason : String(500) not null; recordedAt : Timestamp not null; }
